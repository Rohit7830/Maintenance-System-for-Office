<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maintenance Portal</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root{
  --bg:#f0f2f5;--card:#fff;--border:#e2e6ea;--text:#1a1d23;--muted:#6b7280;
  --accent:#2563eb;--accent-l:#eff6ff;--accent-h:#1d4ed8;
  --ok:#16a34a;--ok-bg:#f0fdf4;--warn:#d97706;--warn-bg:#fffbeb;
  --err:#dc2626;--err-bg:#fef2f2;--purple:#7c3aed;--purple-bg:#f5f3ff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--bg);min-height:100vh;color:var(--text)}

/* ── SCREENS ── */
.screen{display:none}
.screen.active{display:block}
#roleScreen.active{display:flex}

/* ── ROLE SELECTION ── */
#roleScreen{min-height:100vh;flex-direction:column;align-items:center;justify-content:center;padding:24px}
.role-top{text-align:center;margin-bottom:40px}
.role-logo{width:60px;height:60px;background:var(--accent);border-radius:16px;
  display:flex;align-items:center;justify-content:center;margin:0 auto 18px}
.role-top h1{font-size:24px;font-weight:700;margin-bottom:8px}
.role-top p{color:var(--muted);font-size:14px}
.role-cards{display:flex;gap:20px;flex-wrap:wrap;justify-content:center}
.role-card{background:#fff;border:2.5px solid var(--border);border-radius:20px;
  padding:32px 36px;cursor:pointer;transition:all .2s;text-align:center;min-width:200px}
.role-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.10)}
.role-card.user-card:hover{border-color:var(--accent)}
.role-card.admin-card:hover{border-color:var(--purple)}
.ri{width:60px;height:60px;border-radius:16px;display:flex;align-items:center;
  justify-content:center;font-size:28px;margin:0 auto 16px}
.user-card .ri{background:#dbeafe}
.admin-card .ri{background:var(--purple-bg)}
.role-card h3{font-size:17px;font-weight:600;margin-bottom:6px}
.role-card p{font-size:13px;color:var(--muted);line-height:1.5}
.user-card h3{color:var(--accent)}
.admin-card h3{color:var(--purple)}

/* ── PASSWORD MODAL ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:100;align-items:center;justify-content:center;padding:20px}
.overlay.show{display:flex}
.modal{background:#fff;border-radius:18px;padding:32px;width:100%;max-width:360px;
  box-shadow:0 24px 60px rgba(0,0,0,.18)}
.modal h2{font-size:19px;font-weight:700;margin-bottom:4px}
.modal>p{color:var(--muted);font-size:13px;margin-bottom:22px}
.mf label{font-size:13px;font-weight:500;display:block;margin-bottom:5px}
.mf input{width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:9px;
  font-size:14px;font-family:'Inter',sans-serif;outline:none;transition:.12s}
.mf input:focus{border-color:var(--purple)}
.merr{color:var(--err);font-size:12px;margin-top:8px;display:none;font-weight:500}
.mbtns{display:flex;gap:8px;margin-top:18px}
.mbtn{flex:1;padding:11px;border:none;border-radius:9px;font-size:14px;font-weight:600;
  cursor:pointer;font-family:'Inter',sans-serif;transition:.12s;
  display:flex;align-items:center;justify-content:center;gap:6px}
.mbtn.cancel{background:#f3f4f6;color:var(--text)}
.mbtn.cancel:hover{background:#e5e7eb}
.mbtn.go{background:var(--purple);color:#fff}
.mbtn.go:hover{background:#6d28d9}
.mbtn:disabled{opacity:.6;cursor:not-allowed}

/* ── HEADER ── */
header{background:#fff;border-bottom:1px solid var(--border);height:62px;
  display:flex;align-items:center;justify-content:space-between;padding:0 24px;
  position:sticky;top:0;z-index:10;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.hlogo{display:flex;align-items:center;gap:12px}
.hic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.hic.blue{background:var(--accent)}
.hic.purple{background:var(--purple)}
header h1{font-size:15px;font-weight:600}
.hbadge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;letter-spacing:.04em}
.hbadge.u{background:var(--accent-l);color:var(--accent)}
.hbadge.a{background:var(--purple-bg);color:var(--purple)}
.back-btn{padding:7px 16px;border:1.5px solid var(--border);border-radius:8px;
  background:#fff;font-size:13px;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;transition:.12s}
.back-btn:hover{border-color:var(--accent);color:var(--accent)}

/* ── USER FORM ── */
#userScreen .page{max-width:700px;margin:28px auto;padding:0 16px 60px}
.sec{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;
  color:var(--muted);margin-bottom:10px;margin-top:22px}
.cats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cat{border:2px solid var(--border);border-radius:12px;padding:14px 16px;cursor:pointer;
  transition:.15s;background:#fff;display:flex;align-items:center;gap:12px;user-select:none}
.cat:hover,.cat.active{border-color:var(--accent);background:var(--accent-l)}
.caticon{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;
  justify-content:center;font-size:18px;flex-shrink:0}
.cat[data-c="ELECTRICAL"] .caticon{background:#fef3c7}
.cat[data-c="IT"] .caticon{background:#dbeafe}
.cat[data-c="FURNITURE"] .caticon{background:#ede9fe}
.cat[data-c="HOUSEKEEPING"] .caticon{background:#d1fae5}
.cl{font-size:13px;font-weight:500;line-height:1.35}
.cs{font-size:11px;color:var(--muted);margin-top:2px}
.chips{display:flex;flex-wrap:wrap;gap:7px;padding:2px 0 4px}
.chip{border:1.5px solid var(--border);border-radius:20px;padding:5px 13px;
  font-size:12px;font-weight:500;cursor:pointer;background:#fff;transition:.12s;color:var(--text)}
.chip:hover,.chip.active{border-color:var(--accent);background:var(--accent-l);color:var(--accent)}
.prow{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pb{border:1.5px solid var(--border);border-radius:10px;padding:10px;cursor:pointer;
  background:#fff;text-align:center;transition:.12s;font-family:'Inter',sans-serif}
.pb:hover{border-color:var(--accent)}
.pb[data-p="LOW"].active{border-color:#16a34a;background:#f0fdf4}
.pb[data-p="MEDIUM"].active{border-color:#d97706;background:#fffbeb}
.pb[data-p="HIGH"].active{border-color:#dc2626;background:#fef2f2}
.pe{font-size:18px;display:block;margin-bottom:3px}
.pl{font-size:12px;font-weight:500}
.card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:20px;
  box-shadow:0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06)}
.field{margin-bottom:14px}
.field:last-child{margin-bottom:0}
label{font-size:13px;font-weight:500;display:block;margin-bottom:5px}
.req{color:var(--err);margin-left:2px}
input[type=text],input[type=tel],textarea{width:100%;padding:10px 13px;
  border:1.5px solid var(--border);border-radius:9px;font-size:14px;
  font-family:'Inter',sans-serif;color:var(--text);background:#fff;transition:.12s;outline:none}
input:focus,textarea:focus{border-color:var(--accent)}
textarea{resize:vertical;min-height:90px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.sbtn{width:100%;padding:13px;background:var(--accent);color:#fff;border:none;
  border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;
  font-family:'Inter',sans-serif;transition:.12s;margin-top:6px;
  display:flex;align-items:center;justify-content:center;gap:8px}
.sbtn:hover{background:var(--accent-h)}
.sbtn:disabled{opacity:.6;cursor:not-allowed}
.spin{width:18px;height:18px;border:2.5px solid rgba(255,255,255,.3);
  border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:none}
@keyframes spin{to{transform:rotate(360deg)}}
#successBox{display:none;text-align:center;padding:48px 20px}
.sc{width:72px;height:72px;background:var(--ok-bg);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:32px;
  margin:0 auto 20px;border:2px solid #bbf7d0}
#successBox h2{font-size:22px;margin-bottom:8px}
#successBox p{color:var(--muted);font-size:14px;margin-bottom:6px}
.tid{display:inline-block;background:var(--accent-l);color:var(--accent);border-radius:20px;
  padding:6px 20px;font-size:15px;font-weight:700;letter-spacing:.06em;margin:10px 0 24px}
.nbtn{padding:11px 28px;background:var(--accent);color:#fff;border:none;border-radius:10px;
  font-size:14px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif}
.nbtn:hover{background:var(--accent-h)}

/* ── ADMIN DASHBOARD ── */
#adminScreen .apage{max-width:1100px;margin:0 auto;padding:24px 16px 60px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.stat{background:#fff;border:1px solid var(--border);border-radius:12px;padding:16px 18px;
  box-shadow:0 1px 3px rgba(0,0,0,.06)}
.stat-val{font-size:30px;font-weight:700;line-height:1}
.stat-lbl{font-size:12px;color:var(--muted);margin-top:4px;font-weight:500}
.stat.total .stat-val{color:var(--accent)}
.stat.open  .stat-val{color:var(--err)}
.stat.prog  .stat-val{color:var(--warn)}
.stat.done  .stat-val{color:var(--ok)}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;align-items:center}
.fchip{border:1.5px solid var(--border);border-radius:20px;padding:5px 14px;font-size:12px;
  font-weight:500;cursor:pointer;background:#fff;transition:.12s;color:var(--text);
  font-family:'Inter',sans-serif}
.fchip:hover,.fchip.active{border-color:var(--accent);background:var(--accent-l);color:var(--accent)}
.fsearch{padding:8px 14px;border:1.5px solid var(--border);border-radius:20px;font-size:13px;
  font-family:'Inter',sans-serif;outline:none;width:240px;transition:.12s}
.fsearch:focus{border-color:var(--accent)}
.rfbtn{margin-left:auto;padding:8px 16px;background:var(--accent);color:#fff;border:none;
  border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;
  display:flex;align-items:center;gap:6px}
.rfbtn:hover{background:var(--accent-h)}
.tbl-wrap{background:#fff;border:1px solid var(--border);border-radius:14px;
  overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.tbl-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:750px}
thead tr{background:#f8fafc;border-bottom:2px solid var(--border)}
th{padding:12px 14px;font-size:11px;font-weight:600;text-transform:uppercase;
  letter-spacing:.06em;color:var(--muted);text-align:left;white-space:nowrap}
td{padding:13px 14px;font-size:13px;border-bottom:1px solid #f1f3f5;vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:#fafbfc}
.pri-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;
  border-radius:20px;font-size:11px;font-weight:600}
.pri-HIGH{background:#fef2f2;color:var(--err)}
.pri-MEDIUM{background:#fffbeb;color:var(--warn)}
.pri-LOW{background:#f0fdf4;color:var(--ok)}
.status-sel{padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;
  font-size:12px;font-family:'Inter',sans-serif;font-weight:500;cursor:pointer;
  outline:none;background:#fff;transition:.12s}
.status-sel.OPEN{border-color:#fecaca;color:var(--err);background:#fef2f2}
.status-sel.IN_PROGRESS{border-color:#fed7aa;color:var(--warn);background:#fffbeb}
.status-sel.CLOSED{border-color:#bbf7d0;color:var(--ok);background:#f0fdf4}
.cat-badge{font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px}
.cat-ELECTRICAL{background:#fef3c7;color:#92400e}
.cat-IT{background:#dbeafe;color:#1e40af}
.cat-FURNITURE{background:#ede9fe;color:#5b21b6}
.cat-HOUSEKEEPING{background:#d1fae5;color:#065f46}
.empty{text-align:center;padding:56px;color:var(--muted)}
.empty-icon{font-size:40px;margin-bottom:12px}
.loading{text-align:center;padding:40px;color:var(--muted);font-size:14px}

/* ── TOAST ── */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(100px);
  min-width:280px;border-radius:12px;padding:13px 20px;display:flex;align-items:center;
  gap:10px;font-size:14px;font-weight:500;box-shadow:0 8px 32px rgba(0,0,0,.14);
  transition:transform .3s cubic-bezier(.34,1.56,.64,1);z-index:999}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast.ok{background:var(--ok-bg);border:1.5px solid #bbf7d0;color:var(--ok)}
.toast.err{background:var(--err-bg);border:1.5px solid #fecaca;color:var(--err)}

@media(max-width:600px){
  .cats,.two{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr 1fr}
  .role-cards{flex-direction:column;align-items:center}
}
</style>
</head>
<body>

<!-- ══════════════ SCREEN: ROLE ══════════════ -->
<div id="roleScreen" class="screen active">
  <div class="role-top">
    <div class="role-logo">
      <svg width="28" height="28" fill="none" stroke="#fff" stroke-width="2.2" viewBox="0 0 24 24">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </div>
    <h1>Maintenance Portal</h1>
    <p>Transparent Overseas — Office Maintenance System</p>
  </div>
  <div class="role-cards">
    <div class="role-card user-card" onclick="openUser()">
      <div class="ri">👤</div>
      <h3>Employee</h3>
      <p>Raise a new<br>maintenance request</p>
    </div>
    <div class="role-card admin-card" onclick="showPassModal()">
      <div class="ri">🛡️</div>
      <h3>Admin</h3>
      <p>View &amp; manage<br>all tickets</p>
    </div>
  </div>
</div>

<!-- ══════════════ MODAL: PASSWORD ══════════════ -->
<div class="overlay" id="passOverlay">
  <div class="modal">
    <h2>🛡️ Admin Access</h2>
    <p>Enter admin password to continue</p>
    <div class="mf">
      <label>Password</label>
      <input id="adminPass" type="password" placeholder="Enter password"
        onkeydown="if(event.key==='Enter')checkPass()">
    </div>
    <div class="merr" id="passErr">❌ Incorrect password. Try again.</div>
    <div class="mbtns">
      <button class="mbtn cancel" onclick="closeModal()">Cancel</button>
      <button class="mbtn go" id="passbtn" onclick="checkPass()">
        <div class="spin" id="pspin" style="border-color:rgba(255,255,255,.3);border-top-color:#fff"></div>
        <span id="passtxt">Enter Dashboard</span>
      </button>
    </div>
  </div>
</div>

<!-- ══════════════ SCREEN: USER FORM ══════════════ -->
<div id="userScreen" class="screen">
  <header>
    <div class="hlogo">
      <div class="hic blue">
        <svg width="18" height="18" fill="none" stroke="#fff" stroke-width="2.2" viewBox="0 0 24 24">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </div>
      <h1>Maintenance Request</h1>
      <span class="hbadge u">EMPLOYEE</span>
    </div>
    <button class="back-btn" onclick="goBack()">← Back</button>
  </header>
  <div class="page">
    <div id="successBox">
      <div class="sc">✅</div>
      <h2>Request Submitted!</h2>
      <p>Your ticket has been raised successfully.</p>
      <div class="tid" id="stid"></div>
      <p style="font-size:13px;color:var(--muted)">HR has been notified. Note this ID for follow-up.</p>
      <br>
      <button class="nbtn" onclick="resetForm()">＋ Raise Another Request</button>
    </div>
    <div id="formArea">
      <div class="sec">Category <span style="color:var(--err)">*</span></div>
      <div class="cats">
        <div class="cat" data-c="ELECTRICAL" onclick="selCat(this)"><div class="caticon">⚡</div><div><div class="cl">Electrical / AC / Plumbing</div><div class="cs">Power, cooling, pipes</div></div></div>
        <div class="cat" data-c="IT" onclick="selCat(this)"><div class="caticon">💻</div><div><div class="cl">IT / Computer Issues</div><div class="cs">Hardware, network, software</div></div></div>
        <div class="cat" data-c="FURNITURE" onclick="selCat(this)"><div class="caticon">🪑</div><div><div class="cl">Furniture / Civil Work</div><div class="cs">Repairs, painting, civil</div></div></div>
        <div class="cat" data-c="HOUSEKEEPING" onclick="selCat(this)"><div class="caticon">🧹</div><div><div class="cl">Housekeeping / Cleaning</div><div class="cs">Cleaning, sanitisation</div></div></div>
      </div>
      <div id="subWrap" style="display:none">
        <div class="sec">Sub-category</div>
        <div class="chips" id="subList"></div>
      </div>
      <div class="sec" style="margin-top:20px">Priority <span style="color:var(--err)">*</span></div>
      <div class="prow">
        <button class="pb" data-p="LOW"    onclick="selP(this)"><span class="pe">🟢</span><span class="pl">Low</span></button>
        <button class="pb" data-p="MEDIUM" onclick="selP(this)"><span class="pe">🟡</span><span class="pl">Medium</span></button>
        <button class="pb" data-p="HIGH"   onclick="selP(this)"><span class="pe">🔴</span><span class="pl">High / Urgent</span></button>
      </div>
      <div class="sec" style="margin-top:22px">Your Details</div>
      <div class="card">
        <div class="two">
          <div class="field"><label>Name <span class="req">*</span></label><input id="iname" type="text" placeholder="Full name"></div>
          <div class="field"><label>Department</label><input id="iempid" type="text" placeholder="e.g. Sales, HR, IT"></div>
        </div>
        <div class="two">
          <div class="field"><label>Contact Number</label><input id="icontact" type="tel" placeholder="Mobile / Extension"></div>
          <div class="field"><label>Email Address <span class="req">*</span></label><input id="iemail" type="text" placeholder="yourname@company.com"></div>
        </div>
        <div class="field"><label>Location / Room No. <span class="req">*</span></label><input id="iloc" type="text" placeholder="e.g. 2nd Floor, Room 204"></div>
        <div class="field"><label>Issue Description <span class="req">*</span></label><textarea id="idesc" placeholder="Describe the problem clearly..."></textarea></div>
        <button class="sbtn" id="sbtn" onclick="doSubmit()">
          <div class="spin" id="fspin"></div>
          <span id="sbtxt">Submit Request</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════ SCREEN: ADMIN ══════════════ -->
<div id="adminScreen" class="screen">
  <header>
    <div class="hlogo">
      <div class="hic purple">
        <svg width="18" height="18" fill="none" stroke="#fff" stroke-width="2.2" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h1>Maintenance Dashboard</h1>
      <span class="hbadge a">ADMIN</span>
    </div>
    <button class="back-btn" onclick="goBack()">← Logout</button>
  </header>
  <div class="apage">
    <div class="stats">
      <div class="stat total"><div class="stat-val" id="sTotal">—</div><div class="stat-lbl">Total Tickets</div></div>
      <div class="stat open"> <div class="stat-val" id="sOpen">—</div> <div class="stat-lbl">Open</div></div>
      <div class="stat prog"> <div class="stat-val" id="sProg">—</div> <div class="stat-lbl">In Progress</div></div>
      <div class="stat done"> <div class="stat-val" id="sDone">—</div> <div class="stat-lbl">Closed</div></div>
    </div>
    <div class="filters">
      <button class="fchip active" data-f="ALL"         onclick="setFilter(this)">All</button>
      <button class="fchip"        data-f="OPEN"        onclick="setFilter(this)">🔴 Open</button>
      <button class="fchip"        data-f="IN PROGRESS" onclick="setFilter(this)">🟡 In Progress</button>
      <button class="fchip"        data-f="CLOSED"      onclick="setFilter(this)">🟢 Closed</button>
      <input class="fsearch" id="searchBox" placeholder="🔍  Search name, location, ID…" oninput="renderTable()">
      <button class="rfbtn" onclick="loadData()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Refresh
      </button>
    </div>
    <div class="tbl-wrap">
      <div class="tbl-scroll">
        <table>
          <thead><tr>
            <th>Ticket ID</th><th>Date</th><th>Employee</th><th>Location</th>
            <th>Category</th><th>Priority</th><th>Description</th><th>Status</th>
          </tr></thead>
          <tbody id="tbody">
            <tr><td colspan="8"><div class="loading">Loading tickets…</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"><span id="ticon"></span>&nbsp;<span id="tmsg"></span></div>

<script>
/* ── DATA ── */
const SUBS={
  ELECTRICAL:["Electrical Fault","AC Not Working","AC Leaking","Light Issue","Power Outage","Water Leakage","Plumbing Issue","Generator Issue","Other"],
  IT:["Computer Not Working","Slow System","Internet / WiFi","Printer Issue","Software Problem","New Hardware Request","CCTV / Intercom","Other"],
  FURNITURE:["Chair / Table Repair","Door / Window Repair","Painting / Whitewash","Civil Repair","Partition Work","Flooring Issue","Other"],
  HOUSEKEEPING:["Deep Cleaning","Washroom Cleaning","Pest Control","Garbage Removal","Sanitisation","Supply Refill","Other"]
};
let cat="", sub="", pri="", allTickets=[], activeFilter="ALL";

/* ── SCREEN NAVIGATION ── */
function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>{
    s.classList.remove("active");
    s.style.display="none";
  });
  const el=document.getElementById(id);
  el.style.display = id==="roleScreen" ? "flex" : "block";
  el.classList.add("active");
}
function openUser(){ showScreen("userScreen"); }
function goBack(){
  showScreen("roleScreen");
  document.getElementById("adminPass").value="";
  document.getElementById("passErr").style.display="none";
}

/* ── MODAL ── */
function showPassModal(){
  document.getElementById("passOverlay").classList.add("show");
  setTimeout(()=>document.getElementById("adminPass").focus(),150);
}
function closeModal(){
  document.getElementById("passOverlay").classList.remove("show");
  document.getElementById("adminPass").value="";
  document.getElementById("passErr").style.display="none";
}
function checkPass(){
  const p=document.getElementById("adminPass").value.trim();
  if(!p) return;
  setBtnLoading("passbtn","pspin","passtxt","Verifying…",true);
  document.getElementById("passErr").style.display="none";
  google.script.run
    .withSuccessHandler(function(res){
      setBtnLoading("passbtn","pspin","passtxt","Enter Dashboard",false);
      if(res && res.success){
        closeModal();
        showScreen("adminScreen");
        loadData();
      } else {
        document.getElementById("passErr").style.display="block";
      }
    })
    .withFailureHandler(function(){
      setBtnLoading("passbtn","pspin","passtxt","Enter Dashboard",false);
      document.getElementById("passErr").style.display="block";
    })
    .adminLogin(p);
}

/* ── FORM ── */
function selCat(el){
  document.querySelectorAll(".cat").forEach(c=>c.classList.remove("active"));
  el.classList.add("active"); cat=el.dataset.c; sub="";
  const list=document.getElementById("subList"); list.innerHTML="";
  SUBS[cat].forEach(s=>{
    const c=document.createElement("div"); c.className="chip"; c.textContent=s;
    c.onclick=()=>{document.querySelectorAll(".chip").forEach(x=>x.classList.remove("active"));c.classList.add("active");sub=s;};
    list.appendChild(c);
  });
  document.getElementById("subWrap").style.display="block";
}
function selP(el){
  document.querySelectorAll(".pb").forEach(b=>b.classList.remove("active"));
  el.classList.add("active"); pri=el.dataset.p;
}
function doSubmit(){
  const name=v("iname"), empId=v("iempid"), contact=v("icontact"), email=v("iemail"), loc=v("iloc"), desc=v("idesc");
  if(!cat)   return toast("err","Category required","Ek category select karo");
  if(!email) return toast("err","Email required","Apna email address bharo");
  if(!/^[^@]+@[^@]+\.[^@]+$/.test(email)) return toast("err","Invalid email","Valid email address daalo");
  if(!pri)   return toast("err","Priority required","Low, Medium ya High choose karo");
  if(!name)  return toast("err","Name required","Apna naam bharo");
  if(!loc)   return toast("err","Location required","Room ya area likho");
  if(!desc)  return toast("err","Description required","Issue describe karo");
  setBtnLoading("sbtn","fspin","sbtxt","Submitting…",true);
  google.script.run
    .withSuccessHandler(function(res){
      setBtnLoading("sbtn","fspin","sbtxt","Submit Request",false);
      if(res && res.success){
        document.getElementById("stid").textContent=res.ticketId;
        document.getElementById("formArea").style.display="none";
        document.getElementById("successBox").style.display="block";
      } else {
        toast("err","Save failed", res ? res.error : "Unknown error");
      }
    })
    .withFailureHandler(function(err){
      setBtnLoading("sbtn","fspin","sbtxt","Submit Request",false);
      toast("err","Error", err.message||"Please try again");
    })
    .saveTicket({name,empId,contact,email,location:loc,category:cat,subcategory:sub,priority:pri,description:desc});
}
function resetForm(){
  document.getElementById("successBox").style.display="none";
  document.getElementById("formArea").style.display="block";
  document.querySelectorAll(".cat,.pb,.chip").forEach(e=>e.classList.remove("active"));
  document.getElementById("subWrap").style.display="none";
  cat=sub=pri="";
  ["iname","iempid","icontact","iemail","iloc","idesc"].forEach(id=>document.getElementById(id).value="");
}

/* ── ADMIN ── */
function loadData(){
  document.getElementById("tbody").innerHTML='<tr><td colspan="8"><div class="loading">Loading tickets…</div></td></tr>';
  google.script.run
    .withSuccessHandler(function(tickets){
      allTickets = tickets || [];
      renderTable();
    })
    .withFailureHandler(function(e){
      document.getElementById("tbody").innerHTML='<tr><td colspan="8"><div class="empty"><div class="empty-icon">⚠️</div>Failed to load. Click Refresh.</div></td></tr>';
      toast("err","Load failed", e.message||"Try refreshing");
    })
    .getTickets();

  google.script.run
    .withSuccessHandler(function(s){
      document.getElementById("sTotal").textContent = s.total;
      document.getElementById("sOpen").textContent  = s.open;
      document.getElementById("sProg").textContent  = s.progress;
      document.getElementById("sDone").textContent  = s.closed;
    })
    .getDashboardStats();
}

function setFilter(el){
  document.querySelectorAll(".fchip").forEach(c=>c.classList.remove("active"));
  el.classList.add("active");
  activeFilter=el.dataset.f;
  renderTable();
}

function renderTable(){
  const q=document.getElementById("searchBox").value.toLowerCase().trim();
  let rows=[...allTickets];
  if(activeFilter!=="ALL") rows=rows.filter(t=>String(t.status||"").toUpperCase()===activeFilter);
  if(q) rows=rows.filter(t=>
    [t.ticketId,t.name,t.location,t.category,t.description,t.empId]
    .some(v=>String(v||"").toLowerCase().includes(q))
  );
  const tbody=document.getElementById("tbody");
  if(!rows.length){
    tbody.innerHTML='<tr><td colspan="8"><div class="empty"><div class="empty-icon">📋</div>No tickets found</div></td></tr>';
    return;
  }
  tbody.innerHTML=rows.map(t=>{
    const sk = String(t.status||"OPEN").toUpperCase().replace(/ /g,"_");
    const ck = String(t.category||"").toUpperCase();
    const pk = String(t.priority||"LOW").toUpperCase();
    const pe = {HIGH:"🔴",MEDIUM:"🟡",LOW:"🟢"}[pk]||"⚪";
    const desc = String(t.description||"");
    const shortDesc = desc.length>55 ? desc.slice(0,55)+"…" : desc;
    const statusVal = String(t.status||"OPEN");
    return `<tr>
      <td><strong style="color:var(--accent)">${t.ticketId||""}</strong></td>
      <td style="white-space:nowrap;color:var(--muted);font-size:12px">${t.date||""}</td>
      <td>
        <div style="font-weight:500">${t.name||""}</div>
        <div style="font-size:11px;color:var(--muted)">${t.empId||""}${t.contact?" &middot; "+t.contact:""}</div>
      </td>
      <td style="font-size:12px">${t.location||""}</td>
      <td>
        <span class="cat-badge cat-${ck}">${t.category||""}</span>
        <div style="font-size:11px;color:var(--muted);margin-top:3px">${t.subcategory||""}</div>
      </td>
      <td><span class="pri-badge pri-${pk}">${pe} ${t.priority||""}</span></td>
      <td style="font-size:12px;max-width:180px;color:var(--text)">${shortDesc}</td>
      <td>
        <select class="status-sel ${sk}" data-tid="${t.ticketId}" onchange="changeStatus(this)">
          <option value="OPEN"        ${statusVal==="OPEN"?"selected":""}>🔴 Open</option>
          <option value="IN PROGRESS" ${statusVal==="IN PROGRESS"?"selected":""}>🟡 In Progress</option>
          <option value="CLOSED"      ${(statusVal==="CLOSED"||statusVal==="COMPLETED")?"selected":""}>🟢 Closed</option>
        </select>
      </td>
    </tr>`;
  }).join("");
}

function changeStatus(sel){
  const tid=sel.dataset.tid, ns=sel.value;
  sel.disabled=true;
  google.script.run
    .withSuccessHandler(function(res){
      sel.disabled=false;
      if(res && res.success){
        const t=allTickets.find(x=>x.ticketId===tid);
        if(t) t.status=ns;
        sel.className="status-sel "+ns.replace(/ /g,"_");
        toast("ok","✅ Status updated: "+ns);
        // refresh stats
        google.script.run.withSuccessHandler(function(s){
          document.getElementById("sTotal").textContent=s.total;
          document.getElementById("sOpen").textContent=s.open;
          document.getElementById("sProg").textContent=s.progress;
          document.getElementById("sDone").textContent=s.closed;
        }).getDashboardStats();
      } else {
        sel.disabled=false;
        toast("err","❌ Update failed");
      }
    })
    .withFailureHandler(function(){
      sel.disabled=false;
      toast("err","❌ Error updating status");
    })
    .updateStatus(tid, ns);
}

/* ── HELPERS ── */
function v(id){ return document.getElementById(id).value.trim(); }
function setBtnLoading(btnId,spinId,txtId,txt,loading){
  document.getElementById(spinId).style.display = loading ? "block" : "none";
  document.getElementById(txtId).textContent = txt;
  document.getElementById(btnId).disabled = loading;
}
let tTimer;
function toast(type,msg){
  const el=document.getElementById("toast");
  document.getElementById("tmsg").textContent=msg;
  el.className="toast "+type+" show";
  clearTimeout(tTimer);
  tTimer=setTimeout(()=>el.classList.remove("show"),3500);
}
</script>
</body>
</html>
