// ═══════════════════════════════════════════════
//  GET ALL TICKETS
// ═══════════════════════════════════════════════
function getTickets() {
  try {
    var sheet = getSheet();
    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) return [];
    var rows = sheet.getRange(2, 1, lastRow - 1, 13).getValues();
    var result = [];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r[0] !== "" && r[0] !== null && r[0] !== undefined) {
        result.push({
          ticketId:    String(r[0]  || ""),
          date:        String(r[1]  || ""),
          name:        String(r[2]  || ""),
          empId:       String(r[3]  || ""),
          contact:     String(r[4]  || ""),
          email:       String(r[5]  || ""),
          location:    String(r[6]  || ""),
          category:    String(r[7]  || ""),
          subcategory: String(r[8]  || ""),
          priority:    String(r[9]  || ""),
          description: String(r[10] || ""),
          status:      String(r[11] || "OPEN"),
          updatedOn:   String(r[12] || "")
        });
      }
    }
    return result;
  } catch(e) {
    Logger.log("getTickets error: " + e.toString());
    return [];
  }
}

// ═══════════════════════════════════════════════
//  UPDATE STATUS
// ═══════════════════════════════════════════════
function updateStatus(ticketId, status) {
  try {
    var sheet = getSheet();
    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) return { success: false, error: "No tickets" };
    var rows = sheet.getRange(2, 1, lastRow - 1, 13).getValues();
    for (var i = 0; i < rows.length; i++) {
      if (String(rows[i][0]) === String(ticketId)) {
        var rowNum = i + 2;
        sheet.getRange(rowNum, 12).setValue(status);
        sheet.getRange(rowNum, 13).setValue(
          Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm")
        );
        if (status === "CLOSED") {
          var empEmail = String(rows[i][5] || "").trim();
          if (empEmail !== "") {
            sendClosureMail(ticketId, {
              name:        String(rows[i][2]  || ""),
              email:       empEmail,
              location:    String(rows[i][6]  || ""),
              category:    String(rows[i][7]  || ""),
              subcategory: String(rows[i][8]  || ""),
              priority:    String(rows[i][9]  || ""),
              description: String(rows[i][10] || "")
            });
          }
        }
        return { success: true };
      }
    }
    return { success: false, error: "Ticket not found" };
  } catch(e) {
    return { success: false, error: e.toString() };
  }
}

// ═══════════════════════════════════════════════
//  DASHBOARD STATS
// ═══════════════════════════════════════════════
function getDashboardStats() {
  try {
    var sheet = getSheet();
    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) return { total: 0, open: 0, progress: 0, closed: 0 };
    var rows = sheet.getRange(2, 1, lastRow - 1, 13).getValues();
    var total = 0, open = 0, progress = 0, closed = 0;
    for (var i = 0; i < rows.length; i++) {
      if (rows[i][0] !== "" && rows[i][0] !== null) {
        total++;
        var s = String(rows[i][11]).toUpperCase().trim();
        if      (s === "OPEN")        open++;
        else if (s === "IN PROGRESS") progress++;
        else if (s === "CLOSED" || s === "COMPLETED") closed++;
      }
    }
    return { total: total, open: open, progress: progress, closed: closed };
  } catch(e) {
    return { total: 0, open: 0, progress: 0, closed: 0 };
  }
}

