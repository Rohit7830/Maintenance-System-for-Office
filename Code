// ═══════════════════════════════════════════════
//  SHEET HELPER
// ═══════════════════════════════════════════════
function getSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(CONFIG.SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.SHEET_NAME);
  }
  if (sheet.getLastRow() === 0) {
    var header = sheet.getRange(1, 1, 1, 13);
    header.setValues([[
      "Ticket ID", "Date", "Name", "Department", "Contact", "Email",
      "Location", "Category", "Sub Category", "Priority",
      "Description", "Status", "Updated On"
    ]]);
    header.setFontWeight("bold");
    header.setBackground("#2563eb");
    header.setFontColor("#ffffff");
    sheet.setFrozenRows(1);
    sheet.setColumnWidth(11, 250);
  }
  return sheet;
}

// ═══════════════════════════════════════════════
//  TICKET ID GENERATOR
// ═══════════════════════════════════════════════
function getNextTicketId() {
  var sheet = getSheet();
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return "MNT-0001";
  var vals = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  var nums = [];
  for (var i = 0; i < vals.length; i++) {
    var v = String(vals[i][0]);
    if (v.indexOf("MNT-") === 0) {
      var n = parseInt(v.replace("MNT-", ""), 10);
      if (!isNaN(n)) nums.push(n);
    }
  }
  var max = nums.length > 0 ? Math.max.apply(null, nums) : 0;
  var next = String(max + 1);
  while (next.length < 4) next = "0" + next;
  return "MNT-" + next;
}

// ═══════════════════════════════════════════════
//  SAVE TICKET
// ═══════════════════════════════════════════════
function saveTicket(data) {
  try {
    var sheet    = getSheet();
    var ticketId = getNextTicketId();
    var dateStr  = Utilities.formatDate(
      new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm"
    );
    sheet.appendRow([
      ticketId,
      dateStr,
      data.name        || "",
      data.empId       || "",
      data.contact     || "",
      data.email       || "",
      data.location    || "",
      data.category    || "",
      data.subcategory || "",
      data.priority    || "",
      data.description || "",
      "OPEN",
      dateStr
    ]);
    sendHRMail(ticketId, data, dateStr);
    if (data.email && data.email.trim() !== "") {
      sendEmployeeMail(ticketId, data, dateStr);
    }
    return { success: true, ticketId: ticketId };
  } catch (err) {
    return { success: false, error: err.toString() };
  }
}

